

import javax.swing.*;
public class main {

	public static void main(String[] args) {
		int points = 0;
		double vitorias = 0;
		JOptionPane.showMessageDialog(null, "Bem vindo aos jogos\n Vamos comecar com Jokenpo");
		JOptionPane.showMessageDialog(null, "Voce ira escolher um numero de 1 a 3 para representar cada elemento\n(1 Para pedra, 2 para tesoura, 3 para papel)\n Ira ser 3 rodadas e voce ganhara 15 pontos a cada, para passar de nivel precisa ganhar no minimo 2");
	int jogada1 =	Integer.parseInt(JOptionPane.showInputDialog("Faça sua jogada"));
		if(jogada1 == 1) {
			points += 15;
			JOptionPane.showMessageDialog(null, "Parabens Voce ganhou a primeira rodada");
		vitorias += 1;
		} else if(jogada1 ==2) {
			JOptionPane.showMessageDialog(null, "Parabens Voce empatou a primeira rodada, isso contara como 0,5 vitorias");
		vitorias += 0.5;
		}else if(jogada1==3){
			JOptionPane.showMessageDialog(null, "Voce perdeu nao pontua");
		}
		int jogada2 = Integer.parseInt(JOptionPane.showInputDialog("Faça sua jogada para a 2 rodada"));
		if(jogada2 == 3) {
			points += 15;
			JOptionPane.showMessageDialog(null, "Parabens Voce ganhou a primeira rodada");
		vitorias += 1;
		} else if(jogada2 == 1) {
			JOptionPane.showMessageDialog(null, "Parabens Voce empatou a primeira rodada, isso contara como 0,5 vitorias");
		vitorias += 0.5;
		}else if(jogada2 == 2){
			JOptionPane.showMessageDialog(null, "Voce perdeu nao pontua");
		}
		int jogada3 = Integer.parseInt(JOptionPane.showInputDialog("Faça sua jogada para a 3 rodada"));
		if(jogada3 == 2) {
			points += 15;
			JOptionPane.showMessageDialog(null, "Parabens Voce ganhou a primeira rodada");
		vitorias += 1;
		} else if(jogada3 == 3) {
			JOptionPane.showMessageDialog(null, "Parabens Voce empatou a primeira rodada, isso contara como 0,5 vitorias");
		vitorias += 0.5;
		}else if(jogada3 == 1){
			JOptionPane.showMessageDialog(null, "Voce perdeu nao pontua");
		}
		if(vitorias < 2) {
			JOptionPane.showMessageDialog(null, "Voce nao conseguiu vitorias suficientes para passar de nivel. Jogo encerrado.");
			return; 
		}
		
		JOptionPane.showMessageDialog(null, "Voce ganhou "+vitorias+" partidas \n e fez "+points+" pontos no total");

	}

}
